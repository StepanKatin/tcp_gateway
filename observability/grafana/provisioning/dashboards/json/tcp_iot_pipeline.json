        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "id": 21,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "RSS memory",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"tcp_gateway\"}",
          "legendFormat": "gateway",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"loader\"}",
          "legendFormat": "loader",
          "refId": "B"
        }
      ]
    }
